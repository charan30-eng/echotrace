# EchoTrace Environment Variables Configuration

# -------------------------------------------------------------
# 1. AI & Grounding Search (Gemini)
# -------------------------------------------------------------
# Required for Gemini AI API calls and live Google Search Grounding.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# -------------------------------------------------------------
# 2. Phase 3: Real Evidence Search Providers (Backend Secrets)
# Configure at least one provider to enable live external web evidence search.
# If none are configured, EchoTrace returns a clear "evidence search unavailable"
# state without generating imaginary or simulated results.
# -------------------------------------------------------------

# Option A: Tavily Search API (Recommended for factual evidence retrieval)
# https://tavily.com
TAVILY_API_KEY=""

# Option B: Serper Google Search API
# https://serper.dev
SERPER_API_KEY=""

# Option C: Google Custom Search JSON API
# https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""

# -------------------------------------------------------------
# 3. Application Hosting & Server Configuration
# -------------------------------------------------------------
# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Optional Server Port for standalone Express deployment
PORT="3000"
